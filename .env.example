# backpack.tf: obrigatória. https://next.backpack.tf/developer/ (login via Steam)
BPTF_API_KEY=

# Access Token da conta backpack.tf para os classificados do Market Scan.
# Opcional; sem ele, o potencial de revenda fica indisponível.
# https://next.backpack.tf/account/api-access
BPTF_USER_TOKEN=

# Steam Web API: só para gerar data/effects.json. https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Banco. No Railway é injetada automaticamente pelo serviço Postgres.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/tf2price

# Nome exato da conta dona do painel (o superadmin). Só ela promove e rebaixa
# administradores, e ninguém mexe nela. Ausente, ou com um nome que não é um
# admin ativo, o painel funciona, mas ninguém promove nem rebaixa.
SUPERADMIN=
